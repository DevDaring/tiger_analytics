# Podium — FastAPI dashboard + inference API on 127.0.0.1:8120, proxied by Caddy.
# Install (needs sudo):
#   sudo cp deploy/podium.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now podium
[Unit]
Description=Podium (Agentic GraphRAG on TigerGraph) on 127.0.0.1:8120
After=network.target

[Service]
User=Debz
WorkingDirectory=/home/Debz/Hackathon/Agentic_GraphRAG/Codes
EnvironmentFile=-/home/Debz/Hackathon/Agentic_GraphRAG/Codes/.env
ExecStart=/home/Debz/Hackathon/Agentic_GraphRAG/Codes/.venv/bin/uvicorn podium.api:app --host 127.0.0.1 --port 8120
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
