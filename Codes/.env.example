# TigerGraph Savanna workspace (create a Database Secret in Savanna -> Database Secrets)
TG_HOST=https://<workspace-id>.i.tgcloud.io
TG_SECRET=
TG_USERNAME=
TG_PASSWORD=
TG_GRAPH=Podium
# LLM providers (any one generative provider + one embedding provider is enough)
Open_AI_2009_Key=
Calude_2009_API_Key=
Claude_workspace_id=
# Podium model configuration (see configs/models.yaml)
PODIUM_ANSWER_MODEL=anthropic:claude-sonnet-5
PODIUM_JUDGE_MODEL=openai:gpt-4.1
PODIUM_EMBED_MODEL=openai:text-embedding-3-small
